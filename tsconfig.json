{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "outDir": "build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "Node",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"]
}
